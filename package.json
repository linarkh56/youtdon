{
  "name": "youtdon",
  "version": "0.1.0",
  "author": "Youtdon",
  "description": "YouTube Donation Player for streamers",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win --dir",
    "dist:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sql.js": "^1.14.2",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.youtdon.desktop",
    "productName": "YouTube Donation Player",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  }
}
